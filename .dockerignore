# Build context root for Cloud Build / local docker build of apps/api.
# Keep this minimal but exclude large / irrelevant paths to speed uploads.

# VCS
.git
.gitignore

# Secrets and local env
.gcp
.gcp/**
.env
.env.*
!.env.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example
secrets
*.sa-key.json
play-submit-key.json

# node_modules (re-installed inside container)
node_modules
apps/**/node_modules
packages/**/node_modules

# Build outputs
.next
apps/**/.next
.turbo
apps/**/.turbo
packages/**/.turbo
out
build
dist
apps/**/dist
packages/**/dist

# Mobile native build outputs
apps/mobile/ios/build
apps/mobile/ios/build-*
apps/mobile/ios/Pods
apps/mobile/ios/DerivedData
apps/mobile/android/build
apps/mobile/android/.gradle
apps/mobile/android/.cxx
apps/mobile/builds
apps/mobile/dist
apps/mobile/.expo

# Web artifacts
apps/web/.next
apps/web/playwright-report
apps/web/test-results

# Temporary: exclude packages/mobile-api from the API build context while
# Agent 1 reorganizes it and the monorepo lockfile stabilizes. The API stub
# does not import from this package; remove this line once the lockfile
# resolves cleanly again.
packages/mobile-api

# Misc
.playwright-cli
.playwright-mcp
.superpowers
screenshots
output
test-results
supabase/.temp
supabase/migrations/drizzle
*.log
.DS_Store
builds
builds-aos-*.log

# Editor / OS
.vscode
.idea
