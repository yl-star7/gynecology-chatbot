generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp"), vector]
  schemas    = ["content", "public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pregnancy_day_contents {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_data_id             String                 @db.Uuid
  day_number               Int
  title                    String?                @db.VarChar(120)
  baby_development_payload Json                   @default("{\"items\": []}")
  baby_message             String?
  mother_changes_payload   Json                   @default("{\"items\": []}")
  display_order            Int                    @default(0)
  created_at               DateTime               @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at               DateTime               @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  pregnancy_week_data      pregnancy_week_data    @relation(fields: [week_data_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pregnancy_week_media     pregnancy_week_media[]
  week_checklists          week_checklists[]
  week_questions           week_questions[]

  @@unique([week_data_id, day_number], map: "pregnancy_day_contents_week_day_unique")
  @@index([week_data_id, display_order], map: "idx_pregnancy_day_contents_display")
  @@schema("content")
}

model pregnancy_documents {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String                @db.VarChar(500)
  content        String
  pregnancy_week Int?
  category       String                @db.VarChar(100)
  embedding      Unsupported("vector")
  metadata       Json                  @default("{}")
  created_at     DateTime              @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@index([category], map: "idx_pregnancy_documents_category")
  @@index([embedding], map: "idx_pregnancy_documents_embedding")
  @@index([pregnancy_week], map: "idx_pregnancy_documents_week")
  @@schema("content")
}

