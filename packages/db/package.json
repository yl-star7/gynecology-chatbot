{
  "name": "@gynecology-chatbot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./src/prisma.ts"
  },
  "scripts": {
    "db:pull": "prisma db pull --schema=./prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.13",
    "drizzle-kit": "^0.31.4",
    "prisma": "^6.1.0",
    "typescript": "^5"
  }
}
