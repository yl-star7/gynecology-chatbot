# Schift workflow → calendar 요약 webhook
# Schift workflow 의 summary_webhook 블록이 호출. stage=2 + selectedQuestionId 턴의
# 응답을 요약해 calendar_logs(entry_type=question_summary) 로 기록.
CALENDAR_SUMMARY_WEBHOOK_URL=https://your-host/api/internal/calendar/question-summary
CALENDAR_SUMMARY_WEBHOOK_SECRET=your-calendar-summary-webhook-secret

# Schift stage별 subworkflow IDs
# scripts/provision-subworkflows.ts 실행 후 출력된 ID 를 저장.
# router workflow (maternal-nursing-router.yaml) 가 stage 에 따라 분기 호출.
SCHIFT_WF_BABY_INFO=
SCHIFT_WF_LETTER_REFLECTION=
SCHIFT_WF_FREE_CHAT=
SCHIFT_WF_GENERAL=
QUESTION_CHIP_SUMMARY_ENABLED=false
