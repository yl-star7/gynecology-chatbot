/**
 * Vertex AI RAG Client for medical knowledge retrieval
 */
export class VertexRAGClient {
  private vertexAI: VertexAI | null = null;
  private searchConfig: RAGSearchConfig;

  constructor(config?: RAGSearchConfig) {
    this.searchConfig = {
      maxResults: config?.maxResults || 3,
      minRelevanceScore: config?.minRelevanceScore || 0.7,
      categories: config?.categories,
      includeMetadata: config?.includeMetadata ?? true,
    };

    // Initialize Vertex AI if credentials are available
    try {
      if (process.env.VERTEX_AI_PROJECT_ID) {
        this.vertexAI = initializeVertexAI();
      }
    } catch (error) {
      console.warn('Vertex AI initialization failed, using mock data:', error);
    }
  }

  /**
   * Search for relevant medical knowledge
   */
  async search(query: string, config?: Partial<RAGSearchConfig>): Promise<RAGSource[]> {
    const searchConfig = { ...this.searchConfig, ...config };

    try {
      // If Vertex AI is configured, use it for embedding and search
      if (this.vertexAI) {
        return await this.vertexSearch(query, searchConfig);
      }
      
      // Fallback to mock search
      return await this.mockSearch(query, searchConfig);
    } catch (error) {
      console.error('RAG search error:', error);
      // Fallback to mock search on error
      return await this.mockSearch(query, searchConfig);
    }
  }

  /**
   * Vertex AI-based search (when configured)
   */
  private async vertexSearch(query: string, config: RAGSearchConfig): Promise<RAGSource[]> {
    if (!this.vertexAI) {
      throw new Error('Vertex AI is not initialized');
    }

    try {
      // Get embedding for the query
      const embeddingModel = this.vertexAI.getGenerativeModel({
        model: EMBEDDING_MODEL,
      });

      const embeddingRequest = {
        content: { parts: [{ text: query }] },
      };

      // Note: In production, you would:
      // 1. Generate embeddings for the query
      // 2. Search in your vector database (e.g., Vertex AI Vector Search, Pinecone, etc.)
      // 3. Retrieve relevant documents with similarity scores
      // 4. Format and return the results

      // For now, we'll use a hybrid approach with mock data
      const results = await this.mockSearch(query, config);
      
      // Add Vertex AI enhancement if available
      if (results.length > 0) {
        const model = this.vertexAI.getGenerativeModel({
          model: SEARCH_MODEL,
          generationConfig: {
            temperature: 0.1,
            maxOutputTokens: 256,
          },
          safetySettings: [
            {
              category: HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT,
              threshold: HarmBlockThreshold.BLOCK_ONLY_HIGH,
            },
          ],
        });

        // Enhance relevance scoring using Gemini
        for (const result of results) {
          const prompt = `다음 의료 정보가 사용자 질문과 얼마나 관련이 있는지 0-1 사이의 점수로 평가해주세요.
          
사용자 질문: ${query}
의료 정보: ${result.title} - ${result.content.substring(0, 200)}...

점수만 숫자로 응답하세요 (예: 0.85):`;

          try {
            const response = await model.generateContent(prompt);
            const scoreText = response.response.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || '0';
            const score = parseFloat(scoreText);
            if (!isNaN(score) && score >= 0 && score <= 1) {
              result.relevanceScore = score;
            }
          } catch (error) {
            console.warn('Failed to enhance relevance score:', error);
          }
        }

        // Re-sort by enhanced relevance scores
        results.sort((a, b) => b.relevanceScore - a.relevanceScore);
      }

      return results;
    } catch (error) {
      console.error('Vertex search error:', error);
      throw error;
    }
  }

  /**
   * Enhanced semantic search implementation (fallback/development)
   */
  private async mockSearch(query: string, config: RAGSearchConfig): Promise<RAGSource[]> {
    const queryLower = query.toLowerCase();
    const results: RAGSource[] = [];

    // Enhanced search with multiple ranking factors
    for (const doc of ENHANCED_KNOWLEDGE_BASE) {
      // Filter by category if specified
      if (config.categories && !config.categories.includes(doc.category)) {
        continue;
      }

      let score = 0;
      const titleLower = doc.title.toLowerCase();
      const contentLower = doc.content.toLowerCase();
      const keywordsLower = doc.keywords?.map(k => k.toLowerCase()) || [];

      // 1. Exact phrase matching (highest priority)
      if (contentLower.includes(queryLower)) {
        score += 0.4;
      }
      if (titleLower.includes(queryLower)) {
        score += 0.5;
      }

      // 2. Keyword-based semantic scoring
      const queryTokens = this.tokenizeAndNormalize(queryLower);

      for (const token of queryTokens) {
        // Title keyword matching (high weight)
        if (titleLower.includes(token)) {
          score += 0.25;
        }

        // Content keyword matching (medium weight)
        if (contentLower.includes(token)) {
          score += 0.15;
        }

        // Structured keywords matching (high weight)
        for (const keyword of keywordsLower) {
          if (keyword.includes(token) || token.includes(keyword)) {
            score += 0.3;
          }
        }
      }

      // 3. Medical entity recognition boost
      const medicalEntities = this.getSimpleMedicalEntities(queryLower);
      for (const entity of medicalEntities) {
        if (contentLower.includes(entity) || keywordsLower.some(k => k.includes(entity))) {
          score += 0.2;
        }
      }

      // 4. Evidence level boost (A > B > C)
      if (doc.evidenceLevel === 'A') {
        score += 0.1;
      } else if (doc.evidenceLevel === 'B') {
        score += 0.05;
      }

      // 5. Recency boost (more recent = higher score)
      const daysSinceUpdate = Math.floor((Date.now() - doc.lastUpdated.getTime()) / (1000 * 60 * 60 * 24));
      if (daysSinceUpdate < 30) {
        score += 0.05;
      } else if (daysSinceUpdate < 90) {
        score += 0.02;
      }

      // 6. Context-aware scoring
      score += this.calculateContextScore(queryLower, doc);

      // Normalize and apply threshold
      score = Math.min(score, 1);

      if (score >= config.minRelevanceScore!) {
        results.push({
          id: doc.id,
          title: doc.title,
          content: config.includeMetadata ? doc.content : this.extractRelevantSnippet(doc.content, queryTokens),
          url: doc.url,
          relevanceScore: score,
          category: doc.category,
          lastUpdated: doc.lastUpdated,
        });
      }
    }

    // Advanced sorting: relevance + diversity
    const sortedResults = this.diversitySort(results, config.maxResults!);
    return sortedResults;
  }

  /**
   * Advanced tokenization and normalization for Korean medical text
   */
  private tokenizeAndNormalize(text: string): string[] {
    // Korean medical terminology normalization
    const synonymMap: { [key: string]: string[] } = {
      '임신': ['임신', '임신부', '임산부', '태교', '출산'],
      '당뇨': ['당뇨병', '당뇨', 'DM', '혈당', '인슐린'],
      '입덧': ['입덧', '메스꺼움', '구토', '임신오조', '오심'],
      '엽산': ['엽산', '폴릭애시드', 'folic acid', '비타민B9'],
      '검사': ['검사', '진단', '스크리닝', '테스트', '체크업'],
    };

    const tokens = text.split(/[\s,.\(\)\[\]]+/).filter(token => token.length > 1);
    const expandedTokens = new Set<string>();

    for (const token of tokens) {
      expandedTokens.add(token);

      // Add synonyms
      for (const [key, synonyms] of Object.entries(synonymMap)) {
        if (synonyms.some(syn => syn.includes(token) || token.includes(syn))) {
          synonyms.forEach(syn => expandedTokens.add(syn));
        }
      }
    }

    return Array.from(expandedTokens);
  }

  /**
   * Extract medical entities from query

  /**
   * Simple medical entity extraction for synchronous use
   */
  private getSimpleMedicalEntities(text: string): string[] {
    const medicalTermsDict = [
      // Symptoms
      '입덧', '메스꺼움', '구토', '출혈', '통증', '두통', '어지러움', '부종', '가려움',
      // Conditions
      '임신', '당뇨병', '고혈압', '빈혈', '갑상선', '자궁근종', '난소낭종',
      // Medications
      '엽산', '철분', '비타민', '인슐린', '항생제', '진통제',
      // Procedures
      '초음파', '검사', '수술', '시술', '분만', '제왕절개',
      // Pregnancy stages
      '초기', '중기', '후기', '삼분기', '주수'
    ];

    return medicalTermsDict.filter(term => text.includes(term));
  }
   */

  /**
   * Calculate context-aware relevance score
   */
  private calculateContextScore(query: string, doc: any): number {
    let contextScore = 0;

    // Pregnancy stage matching
    const trimesterPatterns = {
      '초기': ['초기', '1삼분기', '1-12주', '입덧', '유산'],
      '중기': ['중기', '2삼분기', '13-27주', '태동', '기형아검사'],
      '후기': ['후기', '3삼분기', '28-40주', '조산', '출산준비']
    };

    for (const [stage, patterns] of Object.entries(trimesterPatterns)) {
      if (patterns.some(pattern => query.includes(pattern))) {
        if (doc.content.toLowerCase().includes(stage)) {
          contextScore += 0.15;
        }
      }
    }

    // Symptom severity matching
    const urgencyLevels = {
      '응급': ['응급', '즉시', '위험', '심한', '급성'],
      '긴급': ['긴급', '빠른', '조기', '신속'],
      '일반': ['일반적', '보통', '평소', '정상']
    };

    for (const [level, keywords] of Object.entries(urgencyLevels)) {
      if (keywords.some(keyword => query.includes(keyword))) {
        if (doc.content.toLowerCase().includes(level)) {
          contextScore += 0.1;
        }
      }
    }

    return contextScore;
  }

  /**
   * Extract relevant snippet from document content
   */
  private extractRelevantSnippet(content: string, queryTokens: string[]): string {
    const sentences = content.split(/[.!?]\s+/);
    const relevantSentences: { sentence: string; score: number }[] = [];

    for (const sentence of sentences) {
      let score = 0;
      const sentenceLower = sentence.toLowerCase();

      for (const token of queryTokens) {
        if (sentenceLower.includes(token)) {
          score += 1;
        }
      }

      if (score > 0) {
        relevantSentences.push({ sentence, score });
      }
    }

    // Sort by relevance and take top 3 sentences
    relevantSentences.sort((a, b) => b.score - a.score);
    const topSentences = relevantSentences.slice(0, 3).map(rs => rs.sentence);

    return topSentences.join(' ') + (topSentences.length > 0 ? '...' : content.substring(0, 300) + '...');
  }

  /**
   * Diversity-aware result sorting to avoid duplicate information
   */
  private diversitySort(results: RAGSource[], maxResults: number): RAGSource[] {
    if (results.length <= maxResults) {
      return results.sort((a, b) => b.relevanceScore - a.relevanceScore);
    }

    const selected: RAGSource[] = [];
    const remaining = [...results].sort((a, b) => b.relevanceScore - a.relevanceScore);

    // Always include the highest scoring result
    if (remaining.length > 0) {
      selected.push(remaining.shift()!);
    }

    // Select remaining results with diversity consideration
    while (selected.length < maxResults && remaining.length > 0) {
      let bestIndex = 0;
      let bestScore = -1;

      for (let i = 0; i < remaining.length; i++) {
        const candidate = remaining[i];
        let diversityBonus = 0;

        // Bonus for different categories
        if (!selected.some(s => s.category === candidate.category)) {
          diversityBonus += 0.2;
        }

        // Penalty for very similar content
        const similarityPenalty = selected.reduce((penalty, selected) => {
          const commonWords = this.calculateContentSimilarity(selected.content, candidate.content);
          return penalty + (commonWords > 0.7 ? 0.3 : 0);
        }, 0);

        const adjustedScore = candidate.relevanceScore + diversityBonus - similarityPenalty;

        if (adjustedScore > bestScore) {
          bestScore = adjustedScore;
          bestIndex = i;
        }
      }

      selected.push(remaining.splice(bestIndex, 1)[0]);
    }

    return selected;
  }

  /**
   * Calculate content similarity between two texts
   */
  private calculateContentSimilarity(text1: string, text2: string): number {
    const tokens1 = new Set(text1.toLowerCase().split(/\s+/));
    const tokens2 = new Set(text2.toLowerCase().split(/\s+/));

    const intersection = new Set([...tokens1].filter(token => tokens2.has(token)));
    const union = new Set([...tokens1, ...tokens2]);

    return intersection.size / union.size; // Jaccard similarity
  }

  /**
   * Generate context from RAG sources for LLM
   */
  formatRAGContext(sources: RAGSource[]): string {
    if (sources.length === 0) {
      return '';
    }

    let context = '다음은 관련 의료 정보입니다:\n\n';
    
    for (const source of sources) {
      context += `[${source.category}] ${source.title}\n`;
      context += `${source.content}\n`;
      if (source.url) {
        context += `출처: ${source.url}\n`;
      }
      context += '\n---\n\n';
    }

    context += '위 정보를 참고하여 정확하고 도움이 되는 답변을 제공해주세요.';
    
    return context;
  }

  /**
   * Extract medical entities from text
   */
  async extractMedicalEntities(text: string): Promise<{
    symptoms: string[];
    medications: string[];
    conditions: string[];
    procedures: string[];
  }> {
    // Simple pattern-based extraction (in production, use NER models)
    const entities = {
      symptoms: [] as string[],
      medications: [] as string[],
      conditions: [] as string[],
      procedures: [] as string[],
    };

    // Common symptom patterns
    const symptomPatterns = [
      /통증/g, /출혈/g, /구토/g, /메스꺼움/g, /어지러움/g,
      /발열/g, /두통/g, /복통/g, /가려움/g, /부종/g,
    ];

    // Common medication patterns
    const medicationPatterns = [
      /엽산/g, /철분/g, /비타민/g, /인슐린/g, /항생제/g,
      /진통제/g, /소염제/g, /호르몬/g,
    ];

    // Common condition patterns
    const conditionPatterns = [
      /임신/g, /당뇨/g, /고혈압/g, /빈혈/g, /갑상선/g,
      /자궁근종/g, /난소낭종/g, /자궁내막증/g,
    ];

    // Common procedure patterns
    const procedurePatterns = [
      /초음파/g, /검사/g, /수술/g, /시술/g, /분만/g,
      /제왕절개/g, /양수검사/g, /혈액검사/g,
    ];

    // Extract entities
    const textLower = text.toLowerCase();

    for (const pattern of symptomPatterns) {
      const matches = textLower.match(pattern);
      if (matches) {
        entities.symptoms.push(...matches);
      }
    }

    for (const pattern of medicationPatterns) {
      const matches = textLower.match(pattern);
      if (matches) {
        entities.medications.push(...matches);
      }
    }

    for (const pattern of conditionPatterns) {
      const matches = textLower.match(pattern);
      if (matches) {
        entities.conditions.push(...matches);
      }
    }

    for (const pattern of procedurePatterns) {
      const matches = textLower.match(pattern);
      if (matches) {
        entities.procedures.push(...matches);
      }
    }

    // Remove duplicates
    entities.symptoms = [...new Set(entities.symptoms)];
    entities.medications = [...new Set(entities.medications)];
    entities.conditions = [...new Set(entities.conditions)];
    entities.procedures = [...new Set(entities.procedures)];

    return entities;
  }

  /**
   * Update search configuration
   */
  updateConfig(config: Partial<RAGSearchConfig>) {
    this.searchConfig = { ...this.searchConfig, ...config };
  }

  /**
   * Get current configuration
   */
  getConfig(): RAGSearchConfig {
    return { ...this.searchConfig };
  }
}

// Export default instance
export const vertexRAGClient = new VertexRAGClient();

// Export search function for backward compatibility
export const searchKnowledgeBase = async (query: string, config?: Partial<RAGSearchConfig>): Promise<RAGSource[]> => {
  return await vertexRAGClient.search(query, config);
};

// Export enhanced knowledge base for testing and development
export { ENHANCED_KNOWLEDGE_BASE };