import { VertexAI, HarmCategory, HarmBlockThreshold } from '@google-cloud/vertexai';
import type { RAGSource } from '@/types/chat';

// Initialize Vertex AI
const initializeVertexAI = () => {
  const projectId = process.env.VERTEX_AI_PROJECT_ID;
  const location = process.env.VERTEX_AI_LOCATION || 'us-central1';

  if (!projectId) {
    throw new Error('VERTEX_AI_PROJECT_ID is not configured');
  }

  return new VertexAI({
    project: projectId,
    location: location,
  });
};

// Configuration for the embedding model
const EMBEDDING_MODEL = 'textembedding-gecko@003';
const SEARCH_MODEL = 'gemini-1.5-flash';

// Medical knowledge categories
export const MEDICAL_CATEGORIES = {
  PREGNANCY: '임신 및 출산',
  GYNECOLOGY: '부인과 질환',
  REPRODUCTIVE: '생식 건강',
  PRENATAL: '산전 관리',
  POSTNATAL: '산후 관리',
  CONTRACEPTION: '피임 및 가족계획',
  MENSTRUATION: '월경 및 생리',
  MENOPAUSE: '갱년기',
  FERTILITY: '난임 및 불임',
  NUTRITION: '임산부 영양',
} as const;

export type MedicalCategory = typeof MEDICAL_CATEGORIES[keyof typeof MEDICAL_CATEGORIES];

// RAG search configuration
interface RAGSearchConfig {
  maxResults?: number;
  minRelevanceScore?: number;
  categories?: MedicalCategory[];
  includeMetadata?: boolean;
}

