export interface Message {
  id: string;
  conversationId: string;
  role: 'user' | 'assistant' | 'system';
  content: string;
  timestamp: Date;
  metadata?: MessageMetadata;
  ragSources?: RAGSource[];
  feedback?: MessageFeedback;
}

export interface MessageMetadata {
  model?: string;
  temperature?: number;
  maxTokens?: number;
  processingTime?: number;
  tokenCount?: number;
  isStreaming?: boolean;
}

export interface RAGSource {
  id: string;
  title: string;
  content: string;
  url?: string;
  relevanceScore: number;
  category: string;
  lastUpdated: Date;
}

export interface MessageFeedback {
  helpful: boolean;
  rating?: 1 | 2 | 3 | 4 | 5;
  comment?: string;
  reportedIssue?: 'inaccurate' | 'inappropriate' | 'unclear' | 'other';
}

export interface Conversation {
  id: string;
  userId: string;
  title: string;
  createdAt: Date;
  updatedAt: Date;
  messageCount: number;
  status: 'active' | 'archived' | 'deleted';
  tags?: string[];
  summary?: string;
}

export interface ChatRequest {
  message: string;
  conversationId?: string;
  context?: ChatContext;
}

export interface ChatContext {
  pregnancyWeek?: number;
  symptoms?: string[];
  medications?: string[];
  previousConditions?: string[];
}

export interface ChatResponse {
  message: Message;
  suggestions?: string[];
  warnings?: MedicalWarning[];
  sources?: RAGSource[];
}

export interface MedicalWarning {
  severity: 'info' | 'warning' | 'urgent';
  message: string;
  action?: string;
}

export interface StreamingChatResponse {
  chunk: string;
  isComplete: boolean;
  messageId: string;
  sources?: RAGSource[];
}

export interface ChatSettings {
  streamingEnabled: boolean;
  useRAG: boolean;
  temperature: number;
  maxTokens: number;
  systemPrompt?: string;
}